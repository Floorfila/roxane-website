---
const brand = "Eterna";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Eterna — Photographie de mariage & couples. L'instant préservé pour toujours."
    />
    <title>{brand} — Photographie de mariage & couples</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,200;0,300;1,200;1,300&family=Inter:wght@200;300&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>

    <!-- NAV -->
    <header class="nav" id="nav">
      <a href="/" class="nav-logo">{brand}</a>
      <nav>
        <a href="#portfolio">Portfolio</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-phrase">
        <span class="phrase-1">L'instant</span>
        <span class="phrase-2">préservé pour toujours.</span>
      </div>
      <p class="hero-meta">Photographie de mariage &amp; couples</p>
      <div class="hero-scroll" aria-hidden="true"><span></span></div>
    </section>

    <!-- STATEMENT -->
    <section class="statement">
      <p>
        Je ne photographie pas tout.<br />
        Seulement ce qui mérite de rester.
      </p>
    </section>

    <!-- PORTFOLIO -->
    <section class="portfolio" id="portfolio">
      <span class="eyebrow">Portfolio</span>
      <div class="grid">
        <div class="g-item g-tall"><div class="ph ph-1"></div></div>
        <div class="g-item">      <div class="ph ph-2"></div></div>
        <div class="g-item">      <div class="ph ph-3"></div></div>
        <div class="g-item g-wide"><div class="ph ph-4"></div></div>
        <div class="g-item">      <div class="ph ph-5"></div></div>
        <div class="g-item g-tall"><div class="ph ph-6"></div></div>
      </div>
    </section>

    <!-- PRESTATIONS -->
    <section class="prestations">
      <div class="presta-pair">
        <article>
          <h2>Mariage</h2>
          <p>Le chaos, la tendresse, la vérité d'un jour.</p>
          <a href="#contact">Contact →</a>
        </article>
        <article>
          <h2>Couples</h2>
          <p>Ce que vous ne voyez plus. Je le vois.</p>
          <a href="#contact">Contact →</a>
        </article>
      </div>
    </section>

    <!-- BRIDGE -->
    <section class="bridge">
      <p>Vous n'avez rien à préparer.<br />Juste être là.</p>
    </section>

    <!-- CONTACT -->
    <section class="contact" id="contact">
      <div class="contact-inner">
        <h2 class="contact-title">Contact.</h2>
        <p class="contact-sub">Parlez-moi de votre projet. Je vous réponds sous 48 h.</p>
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="sr-only"><label>Ne pas remplir : <input name="bot-field" /></label></p>
          <div class="form-row">
            <div class="field">
              <label for="name">Nom</label>
              <input id="name" type="text" name="name" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" type="email" name="email" required autocomplete="email" />
            </div>
          </div>
          <div class="field">
            <label for="project">Projet</label>
            <select id="project" name="project">
              <option value="">Mariage ou séance couple ?</option>
              <option value="mariage">Mariage</option>
              <option value="couple">Séance couple</option>
              <option value="autre">Autre</option>
            </select>
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="4" required
              placeholder="Votre date, votre lieu, ce que vous imaginez…"></textarea>
          </div>
          <button type="submit">Écrire</button>
        </form>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
      <span>{brand}</span>
      <span>&copy; {new Date().getFullYear()}</span>
      <a href="https://instagram.com/" target="_blank" rel="noopener noreferrer">Instagram</a>
    </footer>

    <script>
      const nav  = document.getElementById('nav');
      const hero = document.querySelector('.hero');
      if (nav && hero) {
        new IntersectionObserver(
          ([e]) => nav.classList.toggle('nav--solid', !e.isIntersecting),
          { threshold: 0.05 }
        ).observe(hero);
      }
    </script>

  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }

  :root {
    --cream:   #f4f0e8;
    --deep:    #181410;
    --ink:     #1e1a16;
    --muted:   #8c8278;
    --warm:    #a89080;   /* accent discret, jamais crié */
    --bd-l:    rgba(30,26,22,0.07);
    --bd-d:    rgba(244,240,232,0.07);
    --serif:   'Cormorant Garamond', Georgia, serif;
    --sans:    'Inter', system-ui, sans-serif;
    --ease:    cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  body {
    background: var(--cream);
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 200;
    line-height: 1.7;
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap;
  }

  /* ── NAV ── */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.6rem 4rem;
    transition: background 0.4s var(--ease), border-color 0.4s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .nav--solid {
    background: rgba(244,240,232,0.95);
    backdrop-filter: blur(10px);
    border-bottom-color: var(--bd-l);
  }
  .nav-logo {
    font-family: var(--serif);
    font-size: 1.4rem; font-weight: 200;
    letter-spacing: 0.3em; text-transform: uppercase;
    text-decoration: none; color: var(--ink);
  }
  .nav nav { display: flex; gap: 2.5rem; }
  .nav nav a {
    font-size: 0.67rem; font-weight: 300;
    letter-spacing: 0.16em; text-transform: uppercase;
    text-decoration: none; color: var(--muted);
    transition: color 0.2s;
  }
  .nav nav a:hover { color: var(--ink); }

  /* ── HERO ── */
  .hero {
    min-height: 100svh;
    display: flex; flex-direction: column;
    justify-content: center;
    padding: 10rem 4rem 6rem;
    position: relative;
  }
  .hero-phrase {
    display: flex; flex-direction: column;
    gap: 0.1em;
    margin-bottom: 3rem;
  }
  .phrase-1 {
    font-family: var(--serif);
    font-style: italic; font-weight: 200;
    font-size: clamp(4rem, 10vw, 9.5rem);
    line-height: 1;
    color: var(--muted);
  }
  .phrase-2 {
    font-family: var(--serif);
    font-weight: 200;
    font-size: clamp(3.2rem, 8vw, 7.5rem);
    line-height: 1.05;
    color: var(--ink);
  }
  .hero-meta {
    font-size: 0.67rem; font-weight: 300;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--muted);
  }
  .hero-scroll {
    position: absolute; bottom: 2.5rem; right: 4rem;
  }
  .hero-scroll span {
    display: block; width: 1px; height: 52px;
    background: linear-gradient(to bottom, var(--warm), transparent);
    animation: tick 2.6s ease-in-out infinite;
  }
  @keyframes tick {
    0%,100% { opacity: 0.2; transform: scaleY(0.4); transform-origin: top; }
    55%      { opacity: 0.6; transform: scaleY(1);   transform-origin: top; }
  }

  /* ── STATEMENT ── */
  .statement {
    background: var(--deep);
    padding: 6rem 4rem;
    text-align: center;
  }
  .statement p {
    font-family: var(--serif);
    font-style: italic; font-weight: 200;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    line-height: 1.6;
    color: rgba(244,240,232,0.75);
  }

  /* ── PORTFOLIO ── */
  .portfolio {
    background: var(--cream);
    padding: 8rem 4rem;
  }
  .eyebrow {
    display: block;
    font-size: 0.65rem; font-weight: 300;
    letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--warm); margin-bottom: 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 300px 220px;
    gap: 3px;
  }
  .g-item { overflow: hidden; }
  .g-tall { grid-row: span 2; }
  .g-wide { grid-column: span 2; }
  .ph {
    width: 100%; height: 100%;
    transition: transform 0.7s var(--ease);
  }
  .g-item:hover .ph { transform: scale(1.02); }
  .ph-1 { background: linear-gradient(150deg,#d8cfc0 0%,#c4b8a4 100%); }
  .ph-2 { background: linear-gradient(200deg,#cec4b2 0%,#b8ad9a 100%); }
  .ph-3 { background: linear-gradient(120deg,#d2c8b4 0%,#bcb09c 100%); }
  .ph-4 { background: linear-gradient(155deg,#ddd4c2 0%,#c8bca6 60%,#aeA494 100%); }
  .ph-5 { background: linear-gradient(220deg,#cac0ae 0%,#b8ad9a 100%); }
  .ph-6 { background: linear-gradient(140deg,#d6cdbf 0%,#bcb2a0 100%); }

  /* ── PRESTATIONS ── */
  .prestations {
    background: var(--deep);
    padding: 8rem 4rem;
  }
  .presta-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    border-top: 1px solid var(--bd-d);
  }
  .presta-pair article {
    padding: 4rem 0 4rem;
    border-bottom: 1px solid var(--bd-d);
    display: flex; flex-direction: column; gap: 1.5rem;
  }
  .presta-pair article:first-child {
    padding-right: 5rem;
    border-right: 1px solid var(--bd-d);
  }
  .presta-pair article:last-child {
    padding-left: 5rem;
  }
  .presta-pair h2 {
    font-family: var(--serif);
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    font-weight: 200; line-height: 1;
    color: rgba(244,240,232,0.9);
  }
  .presta-pair p {
    font-size: 0.88rem; font-weight: 200;
    color: rgba(244,240,232,0.4);
    line-height: 1.7; max-width: 28ch;
  }
  .presta-pair a {
    font-size: 0.7rem; font-weight: 300;
    letter-spacing: 0.12em;
    text-decoration: none;
    color: var(--warm);
    transition: opacity 0.2s;
    align-self: flex-start;
  }
  .presta-pair a:hover { opacity: 0.6; }

  /* ── BRIDGE ── */
  .bridge {
    background: var(--cream);
    padding: 7rem 4rem;
    text-align: center;
  }
  .bridge p {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 200; line-height: 1.5;
    color: var(--ink);
  }

  /* ── CONTACT ── */
  .contact {
    background: var(--deep);
    padding: 8rem 4rem;
  }
  .contact-inner { max-width: 580px; }
  .contact-title {
    font-family: var(--serif);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 200;
    color: rgba(244,240,232,0.9);
    margin-bottom: 0.75rem;
  }
  .contact-sub {
    font-size: 0.85rem; font-weight: 200;
    color: rgba(244,240,232,0.35);
    margin-bottom: 3rem; line-height: 1.7;
  }
  form { display: flex; flex-direction: column; gap: 1.8rem; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.8rem; }
  .field { display: flex; flex-direction: column; gap: 0.45rem; }
  .field label {
    font-size: 0.6rem; font-weight: 300;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(244,240,232,0.3);
  }
  form input, form select, form textarea {
    background: transparent; border: none;
    border-bottom: 1px solid var(--bd-d);
    padding: 0.55rem 0; width: 100%;
    color: rgba(244,240,232,0.8);
    font-family: var(--sans); font-size: 0.9rem; font-weight: 200;
    outline: none; transition: border-color 0.25s;
  }
  form input:focus, form select:focus, form textarea:focus {
    border-bottom-color: var(--warm);
  }
  form select { -webkit-appearance: none; cursor: pointer; }
  form select option { background: var(--deep); color: rgba(244,240,232,0.8); }
  form textarea { resize: vertical; }
  form ::placeholder { color: rgba(244,240,232,0.2); }
  form button {
    align-self: flex-start;
    background: transparent;
    border: 1px solid rgba(244,240,232,0.25);
    padding: 0.75rem 2.5rem;
    color: rgba(244,240,232,0.7);
    font-family: var(--sans); font-size: 0.68rem;
    font-weight: 300; letter-spacing: 0.22em; text-transform: uppercase;
    cursor: pointer; transition: border-color 0.25s, color 0.25s;
  }
  form button:hover {
    border-color: rgba(244,240,232,0.6);
    color: rgba(244,240,232,0.95);
  }

  /* ── FOOTER ── */
  .footer {
    background: var(--deep);
    border-top: 1px solid var(--bd-d);
    padding: 1.5rem 4rem;
    display: flex; justify-content: space-between; align-items: center;
    font-size: 0.65rem; font-weight: 300;
    letter-spacing: 0.1em; color: rgba(244,240,232,0.25);
  }
  .footer a { color: inherit; text-decoration: none; transition: color 0.2s; }
  .footer a:hover { color: rgba(244,240,232,0.6); }

  /* ── RESPONSIVE ── */
  @media (max-width: 860px) {
    .nav { padding: 1.2rem 2rem; }
    section, .portfolio, .prestations, .contact, .bridge, .statement {
      padding-left: 2rem; padding-right: 2rem;
    }
    .hero { padding: 8rem 2rem 5rem; }
    .hero-scroll { right: 2rem; }
    .grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .g-tall, .g-wide { grid-row: auto; grid-column: auto; }
    .presta-pair { grid-template-columns: 1fr; }
    .presta-pair article:first-child {
      padding-right: 0; border-right: none; border-bottom: 1px solid var(--bd-d);
    }
    .presta-pair article:last-child { padding-left: 0; }
    .footer { padding: 1.5rem 2rem; gap: 1rem; flex-wrap: wrap; }
  }

  @media (max-width: 540px) {
    .nav nav { display: none; }
    .grid { grid-template-columns: 1fr; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>
