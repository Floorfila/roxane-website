---
const brand = "Eterna";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Eterna — Photographie de mariage et de couples. Des images qui gardent ce que vous ressentez vraiment."
    />
    <title>{brand} — Photographie de mariage & couples</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,200;0,300;1,200;1,300&family=Inter:wght@200;300&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>

    <!-- ─── NAV ─── -->
    <header class="nav" id="nav">
      <a href="/" class="nav-logo">{brand}</a>
      <nav class="nav-links">
        <a href="#portfolio">Portfolio</a>
        <a href="#prestations">Mariages & Couples</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <!-- ─── HERO (CLAIR) ─── -->
    <section class="hero section--light" aria-label="Introduction">
      <div class="hero-inner">
        <h1 class="hero-headline">
          <em>Ce qui existe<br />entre vous</em><br />
          mérite d'être gardé.
        </h1>
        <p class="hero-sub">Photographie de mariage &amp; couples</p>
        <a href="#contact" class="btn btn--dark">Réserver</a>
      </div>
      <div class="hero-scroll" aria-hidden="true"><span></span></div>
    </section>

    <!-- ─── INTENTION (SOMBRE) ─── -->
    <section class="intention section--dark" aria-label="Intention artistique">
      <div class="intention-inner">
        <p class="intention-text">
          Je cherche ce qui ne se répète pas.<br />
          Le geste juste avant. L'émotion encore là.<br />
          Ce que vous ne voyez plus parce que vous êtes à l'intérieur.
        </p>
      </div>
    </section>

    <!-- ─── PORTFOLIO (CLAIR) ─── -->
    <section class="portfolio section--light" id="portfolio" aria-label="Portfolio">
      <header class="s-header">
        <span class="eyebrow">Portfolio</span>
        <h2 class="s-title">Ce qui reste</h2>
      </header>
      <div class="portfolio-grid">
        <div class="pg-item pg-tall"><div class="ph ph-1"></div></div>
        <div class="pg-item">       <div class="ph ph-2"></div></div>
        <div class="pg-item">       <div class="ph ph-3"></div></div>
        <div class="pg-item pg-wide"><div class="ph ph-4"></div></div>
        <div class="pg-item">       <div class="ph ph-5"></div></div>
        <div class="pg-item pg-tall"><div class="ph ph-6"></div></div>
      </div>
    </section>

    <!-- ─── PRESTATIONS (SOMBRE) ─── -->
    <section class="prestations section--dark" id="prestations" aria-label="Mariages et couples">
      <header class="s-header">
        <span class="eyebrow">Ce que nous vivons ensemble</span>
        <h2 class="s-title">Mariage &amp; Couples</h2>
      </header>
      <div class="presta-grid">

        <article class="presta-card">
          <span class="presta-label">Mariage</span>
          <p class="presta-text">
            Votre journée telle que vous la vivez —
            pas comme on vous la montre.
            Je commence par vous écouter. Je passe la journée
            à chercher ce qui est vrai, entre les lignes du programme.
            Le regard. Le fou rire. La main serrée fort.
          </p>
          <a href="#contact" class="btn btn--outline">Réserver</a>
        </article>

        <article class="presta-card">
          <span class="presta-label">Couples</span>
          <p class="presta-text">
            Une errance à deux, dans un endroit qui vous ressemble.
            Pas de pose. Pas de mise en scène.
            Juste vous, comme vous êtes quand vous oubliez
            qu'on vous regarde.
          </p>
          <a href="#contact" class="btn btn--outline">Réserver</a>
        </article>

      </div>
    </section>

    <!-- ─── EXPÉRIENCE (CLAIR) ─── -->
    <section class="experience section--light" aria-label="Ce que vous vivrez">
      <div class="exp-inner">
        <header class="s-header">
          <span class="eyebrow">L'expérience</span>
          <h2 class="s-title">Vous n'avez rien à préparer.</h2>
        </header>
        <div class="exp-body">
          <p>
            Rien à faire semblant. Pas besoin d'être photogénique, prêt·e,
            ou de savoir comment tenir vos mains.
          </p>
          <p>
            Je serai là, discrète. Je chercherai la lumière qui tombe dans votre
            direction. Le silence juste avant que vous vous embrassiez.
            Le moment où vous riez parce que vous avez oublié que j'existe.
          </p>
          <p class="exp-close">
            C'est ça que je garde.
          </p>
        </div>
      </div>
    </section>

    <!-- ─── CONTACT (SOMBRE) ─── -->
    <section class="contact section--dark" id="contact" aria-label="Contact et réservation">
      <div class="contact-inner">
        <header class="s-header">
          <span class="eyebrow">Contact</span>
          <h2 class="s-title">On se retrouve&nbsp;?</h2>
          <p class="contact-sub">
            Parlez-moi de vous, de votre date, de ce que vous imaginez.
            Je vous réponds sous 48&nbsp;h.
          </p>
        </header>
        <form
          class="contact-form"
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="visually-hidden">
            <label>Ne pas remplir : <input name="bot-field" /></label>
          </p>
          <div class="form-row">
            <div class="form-field">
              <label for="name">Prénom &amp; Nom</label>
              <input id="name" type="text" name="name" required autocomplete="name" />
            </div>
            <div class="form-field">
              <label for="email">Email</label>
              <input id="email" type="email" name="email" required autocomplete="email" />
            </div>
          </div>
          <div class="form-field">
            <label for="project">Votre projet</label>
            <select id="project" name="project">
              <option value="">— Mariage ou séance couple ?</option>
              <option value="mariage">Mariage</option>
              <option value="couple">Séance couple</option>
              <option value="autre">Autre</option>
            </select>
          </div>
          <div class="form-field">
            <label for="message">Votre message</label>
            <textarea id="message" name="message" rows="5" required
              placeholder="Votre date, votre lieu, ce que vous ressentez…"></textarea>
          </div>
          <button type="submit" class="btn btn--light btn--full">Me contacter</button>
        </form>
      </div>
    </section>

    <!-- ─── FOOTER ─── -->
    <footer class="footer section--dark">
      <span class="footer-brand">{brand}</span>
      <p class="footer-copy">&copy; {new Date().getFullYear()} Eterna. Tous droits réservés.</p>
      <a
        class="footer-ig"
        href="https://instagram.com/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram Eterna"
      >Instagram</a>
    </footer>

    <script>
      // Nav : fond visible au scroll
      const nav = document.getElementById('nav');
      const hero = document.querySelector('.hero');
      const io = new IntersectionObserver(
        ([e]) => nav?.classList.toggle('nav--scrolled', !e.isIntersecting),
        { threshold: 0.1 }
      );
      if (hero) io.observe(hero);
    </script>

  </body>
</html>

<style is:global>
  /* ── RESET ─────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }

  :root {
    /* Palettes */
    --cream:      #f5f0e8;
    --cream-2:    #ede8de;
    --deep:       #1c1714;
    --deep-2:     #141210;

    /* Textes */
    --text-on-light:   #201c18;
    --muted-on-light:  #8a7f74;
    --text-on-dark:    #ede8de;
    --muted-on-dark:   #8a8078;

    /* Accent — chaleureux, pas "luxe" */
    --accent:     #b08870;

    /* Bordures */
    --border-l:   rgba(32,28,24,0.08);
    --border-d:   rgba(237,232,222,0.08);

    /* Typo */
    --serif: 'Cormorant Garamond', Georgia, serif;
    --sans:  'Inter', system-ui, sans-serif;
    --ease:  cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  body {
    font-family: var(--sans);
    font-weight: 200;
    line-height: 1.7;
    background: var(--cream);
    color: var(--text-on-light);
  }

  .visually-hidden {
    position: absolute; width: 1px; height: 1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap;
  }

  /* ── SECTION MODES ─────────────────────────── */
  .section--light {
    background: var(--cream);
    color: var(--text-on-light);
  }
  .section--dark {
    background: var(--deep);
    color: var(--text-on-dark);
  }

  /* ── NAV ────────────────────────────────────── */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.5rem 4rem;
    transition: background 0.4s var(--ease), border-color 0.4s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .nav--scrolled {
    background: rgba(245,240,232,0.94);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--border-l);
  }
  .nav-logo {
    font-family: var(--serif);
    font-size: 1.5rem; font-weight: 200;
    letter-spacing: 0.28em; text-transform: uppercase;
    text-decoration: none; color: var(--text-on-light);
  }
  .nav-links { display: flex; gap: 2.5rem; }
  .nav-links a {
    font-size: 0.68rem; font-weight: 300;
    letter-spacing: 0.16em; text-transform: uppercase;
    text-decoration: none; color: var(--muted-on-light);
    transition: color 0.25s;
  }
  .nav-links a:hover { color: var(--text-on-light); }

  /* ── BUTTONS ────────────────────────────────── */
  .btn {
    display: inline-block;
    padding: 0.8rem 2.2rem;
    font-family: var(--sans); font-size: 0.68rem;
    font-weight: 300; letter-spacing: 0.2em;
    text-transform: uppercase; text-decoration: none;
    border: 1px solid; cursor: pointer;
    transition: background 0.3s var(--ease), color 0.3s var(--ease);
  }
  .btn--dark {
    border-color: var(--text-on-light);
    color: var(--text-on-light); background: transparent;
  }
  .btn--dark:hover { background: var(--text-on-light); color: var(--cream); }

  .btn--outline {
    border-color: var(--text-on-dark);
    color: var(--text-on-dark); background: transparent;
  }
  .btn--outline:hover { background: var(--text-on-dark); color: var(--deep); }

  .btn--light {
    border-color: var(--text-on-dark);
    color: var(--deep); background: var(--text-on-dark);
  }
  .btn--light:hover { background: transparent; color: var(--text-on-dark); }

  .btn--full { width: 100%; text-align: center; }

  /* ── SECTION HEADERS ────────────────────────── */
  section { padding: 8rem 4rem; }

  .s-header { margin-bottom: 3.5rem; }

  .eyebrow {
    display: block; font-size: 0.65rem; font-weight: 300;
    letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 0.75rem;
  }
  .s-title {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 200; line-height: 1.15;
  }
  .section--light .s-title  { color: var(--text-on-light); }
  .section--dark  .s-title  { color: var(--text-on-dark);  }

  /* ── HERO ───────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex; align-items: center;
    padding-top: 6rem;
  }
  .hero-inner { padding: 0 4rem 6rem; }
  .hero-headline {
    font-family: var(--serif);
    font-size: clamp(3.2rem, 8vw, 8rem);
    font-weight: 200; line-height: 1.05;
    color: var(--text-on-light);
    margin-bottom: 1.5rem;
  }
  .hero-headline em {
    font-style: italic; font-weight: 200;
    color: var(--muted-on-light);
  }
  .hero-sub {
    font-size: 0.78rem; font-weight: 300;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--muted-on-light); margin-bottom: 2.5rem;
  }
  .hero-scroll {
    position: absolute; bottom: 2.5rem; right: 4rem;
  }
  .hero-scroll span {
    display: block; width: 1px; height: 56px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.25; transform: scaleY(0.5); transform-origin: top; }
    50%       { opacity: 0.7;  transform: scaleY(1);   transform-origin: top; }
  }

  /* ── INTENTION ──────────────────────────────── */
  .intention { text-align: center; }
  .intention-inner { max-width: 640px; margin: 0 auto; }
  .intention-text {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-style: italic; font-weight: 200;
    line-height: 1.6;
    color: var(--text-on-dark);
  }

  /* ── PORTFOLIO ──────────────────────────────── */
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 300px 220px;
    gap: 4px;
  }
  .pg-item { overflow: hidden; }
  .pg-tall { grid-row: span 2; }
  .pg-wide { grid-column: span 2; }
  .ph {
    width: 100%; height: 100%;
    transition: transform 0.65s var(--ease);
  }
  .pg-item:hover .ph { transform: scale(1.025); }

  /* Placeholders : tons chauds, lumineux mais profonds */
  .ph-1 { background: linear-gradient(150deg, #d9cfc2 0%, #c4b8a8 100%); }
  .ph-2 { background: linear-gradient(200deg, #cec4b4 0%, #b8ad9e 100%); }
  .ph-3 { background: linear-gradient(120deg, #d4cab8 0%, #bfb4a0 100%); }
  .ph-4 { background: linear-gradient(155deg, #e0d5c4 0%, #c8bca8 60%, #b0a694 100%); }
  .ph-5 { background: linear-gradient(220deg, #ccc0ae 0%, #b8ad9c 100%); }
  .ph-6 { background: linear-gradient(140deg, #d8cfc0 0%, #c0b5a4 100%); }

  /* ── PRESTATIONS ────────────────────────────── */
  .presta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }
  .presta-card {
    background: var(--deep-2);
    padding: 3.5rem;
    display: flex; flex-direction: column; gap: 1.5rem;
    border: 1px solid var(--border-d);
    transition: border-color 0.3s;
  }
  .presta-card:hover { border-color: rgba(237,232,222,0.2); }
  .presta-label {
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 200;
    color: var(--text-on-dark);
  }
  .presta-text {
    font-size: 0.88rem; font-weight: 200;
    color: var(--muted-on-dark);
    line-height: 1.85; flex: 1;
  }

  /* ── EXPÉRIENCE ─────────────────────────────── */
  .experience { }
  .exp-inner { max-width: 720px; }
  .exp-body {
    display: flex; flex-direction: column; gap: 1.2rem;
    font-size: 0.95rem; font-weight: 200;
    color: var(--muted-on-light); line-height: 1.85;
  }
  .exp-close {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.6rem; font-weight: 200;
    color: var(--text-on-light);
    margin-top: 0.5rem;
  }

  /* ── CONTACT ────────────────────────────────── */
  .contact-inner { max-width: 620px; }
  .contact-sub {
    font-size: 0.88rem; font-weight: 200;
    color: var(--muted-on-dark);
    margin-top: 0.75rem; line-height: 1.7;
  }
  .contact-form {
    display: flex; flex-direction: column; gap: 1.8rem; margin-top: 3rem;
  }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.8rem; }
  .form-field { display: flex; flex-direction: column; gap: 0.5rem; }
  .form-field label {
    font-size: 0.62rem; font-weight: 300;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--muted-on-dark);
  }
  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    background: transparent;
    border: none; border-bottom: 1px solid var(--border-d);
    padding: 0.6rem 0; width: 100%;
    color: var(--text-on-dark);
    font-family: var(--sans); font-size: 0.9rem; font-weight: 200;
    outline: none; transition: border-color 0.25s;
  }
  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus { border-bottom-color: var(--accent); }
  .contact-form select { -webkit-appearance: none; cursor: pointer; }
  .contact-form select option { background: var(--deep); }
  .contact-form textarea { resize: vertical; }
  .contact-form ::placeholder { color: var(--muted-on-dark); opacity: 0.5; }

  /* ── FOOTER ─────────────────────────────────── */
  .footer {
    padding: 2rem 4rem;
    border-top: 1px solid var(--border-d);
    display: grid; grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .footer-brand {
    font-family: var(--serif);
    font-size: 1.1rem; font-weight: 200;
    letter-spacing: 0.28em; text-transform: uppercase;
    color: var(--text-on-dark);
  }
  .footer-copy {
    font-size: 0.68rem; font-weight: 200;
    letter-spacing: 0.06em; color: var(--muted-on-dark);
    text-align: center;
  }
  .footer-ig {
    font-size: 0.68rem; font-weight: 300;
    letter-spacing: 0.16em; text-transform: uppercase;
    text-decoration: none; color: var(--muted-on-dark);
    text-align: right; transition: color 0.25s;
  }
  .footer-ig:hover { color: var(--text-on-dark); }

  /* ── RESPONSIVE ─────────────────────────────── */
  @media (max-width: 900px) {
    .nav { padding: 1.2rem 2rem; }
    .nav-links { gap: 1.5rem; }
    section { padding: 5rem 2rem; }
    .hero-inner { padding: 0 2rem 5rem; }
    .hero-scroll { right: 2rem; }
    .portfolio-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
    }
    .pg-tall, .pg-wide { grid-row: auto; grid-column: auto; }
    .presta-grid { grid-template-columns: 1fr; }
    .presta-card { padding: 2.5rem; }
    .footer { grid-template-columns: 1fr; gap: 0.5rem; text-align: center; padding: 1.5rem 2rem; }
    .footer-ig { text-align: center; }
  }

  @media (max-width: 600px) {
    .nav-links { display: none; }
    .portfolio-grid { grid-template-columns: 1fr; }
    .form-row { grid-template-columns: 1fr; }
    .hero-headline { font-size: clamp(2.8rem, 16vw, 5rem); }
  }
</style>
