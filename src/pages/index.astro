---
import '../styles/site.css';
const brand = "Eterna";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Eterna — Photographie de mariage et de couple. L'instant préservé pour toujours."
    />
    <link rel="alternate" hreflang="en" href="/en/" />
    <title>{brand} — Photographie de mariage et de couple</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,200;0,300;1,200;1,300&family=Inter:wght@200;300&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>

    <!-- NAV -->
    <header class="nav" id="nav">
      <a href="/" class="nav-logo">{brand}</a>
      <div class="nav-right">
        <nav>
          <a href="#portfolio">Portfolio</a>
          <a href="#prestations">Prestations</a>
          <a href="#about">About Me</a>
          <a href="#contact">Contact</a>
        </nav>
        <div class="lang-switch" aria-label="Langue">
          <span class="lang-link lang-active" aria-current="true">FR</span>
          <span class="lang-dot" aria-hidden="true">·</span>
          <a href="/en/" class="lang-link">EN</a>
        </div>
      </div>
      <button class="nav-mobile-btn" id="mobile-btn" aria-label="Ouvrir le menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </header>

    <!-- MENU MOBILE -->
    <div class="nav-mobile" id="mobile-menu" aria-hidden="true">
      <nav class="mobile-links">
        <a href="#portfolio">Portfolio</a>
        <a href="#prestations">Prestations</a>
        <a href="#about">About Me</a>
        <a href="#contact">Contact</a>
      </nav>
      <div class="mobile-lang">
        <span class="lang-link lang-active">FR</span>
        <span class="lang-dot" aria-hidden="true">·</span>
        <a href="/en/" class="lang-link">EN</a>
      </div>
    </div>

    <!-- HERO -->
    <section class="hero" aria-label="Introduction">
      <div class="hero-img" aria-hidden="true"></div>
      <div class="hero-overlay" aria-hidden="true"></div>
      <div class="hero-content">
        <h1 class="hero-brand">{brand}</h1>
        <p class="hero-byline"><span class="by">by</span> <span class="roxane">Roxane</span></p>
        <p class="hero-specialty">Photographie de mariage et de couple</p>
      </div>
    </section>

    <!-- PORTFOLIO -->
    <section class="section" id="portfolio">
      <div class="section-head">
        <h2 class="title">Portfolio</h2>
      </div>
      <div class="gallery">
        {Array.from({ length: 9 }).map((_, i) => (
          <div class="gallery-item">
            <div class={`gallery-ph gallery-ph-${i + 1}`}></div>
          </div>
        ))}
      </div>
    </section>

    <!-- PRESTATIONS -->
    <section class="section" id="prestations">
      <div class="section-head">
        <h2 class="title">Prestations</h2>
      </div>
      <div class="presta-grid">

        <article class="presta-card">
          <h3 class="presta-title">Mariage</h3>
          <p class="presta-desc">
            Je capture votre journée comme vous la vivez ;<br />
            dans le désordre, la tendresse, le chaos, la vérité des moments.
          </p>
          <p class="presta-section-label">Expérience</p>
          <ul class="presta-includes">
            <li>Prise de contact via le formulaire</li>
            <li>Échange sur WhatsApp</li>
            <li>Visio pour découvrir votre histoire</li>
            <li>Puis échanges libres, autant que nécessaire jusqu'au jour J</li>
          </ul>
          <p class="presta-section-label">Ce que vous recevez</p>
          <ul class="presta-includes">
            <li>Reportage complet de la journée</li>
            <li>Fichiers en haute résolution</li>
            <li>Livraison sous 6 semaines</li>
            <li>Un print sélectionné par mon regard</li>
          </ul>
          <p class="presta-price">
            À partir de 2 200 €
            <span class="presta-price-note">Frais de déplacement et hébergement en supplément si nécessaire.</span>
          </p>
          <a href="#contact" class="btn">Me contacter</a>
        </article>

        <article class="presta-card">
          <h3 class="presta-title">Couple</h3>
          <p class="presta-desc">
            Je capture votre moment à deux ;<br />
            votre complicité, votre amour, dans un lieu qui vous ressemble.
          </p>
          <p class="presta-section-label">Expérience</p>
          <ul class="presta-includes">
            <li>Prise de contact via le formulaire</li>
            <li>Échange sur WhatsApp</li>
            <li>Visio rapide pour poser l'intention</li>
            <li>Puis préparation libre selon vos envies</li>
          </ul>
          <p class="presta-section-label">La séance</p>
          <ul class="presta-includes">
            <li>1h30 à 2h</li>
            <li>Dans un lieu réel : café, appartement, train, etc.</li>
          </ul>
          <p class="presta-section-label">Ce que vous recevez</p>
          <ul class="presta-includes">
            <li>Fichiers en haute résolution</li>
            <li>Livraison sous 6 semaines</li>
          </ul>
          <p class="presta-price">
            À partir de 500 €
            <span class="presta-price-note">Frais de déplacement et hébergement en supplément si nécessaire.</span>
          </p>
          <a href="#contact" class="btn">Me contacter</a>
        </article>

      </div>
    </section>

    <!-- ABOUT -->
    <section class="section" id="about">
      <div class="about-grid">
        <div class="about-img-wrap">
          <div class="about-img-ph" aria-hidden="true"></div>
        </div>
        <div class="about-text">
          <h2 class="title">About Me</h2>
          <p>
            À travers mon regard, je cherche à préserver ce qui vous lie :
            l'intensité d'une émotion, la profondeur d'un regard, la beauté de votre amour.
          </p>
          <p>
            Je ne capture pas la perfection.<br />
            Je capture ce qui est vrai, profond, ce qui se ressent.
          </p>
          <p>
            Mon regard se nourrit de tout ce qui m'entoure.
            Un coucher de soleil, une lumière qui disparaît, un paysage, une atmosphère.
          </p>
          <p>
            Je m'inspire de la pellicule :
            de la texture, du grain, des tons doux, des couleurs réelles.
          </p>
          <p>
            Je travaille dans une relation de confiance,
            discrète, présente quand il le faut, invisible quand c'est nécessaire.
          </p>
          <p class="about-location">Basée sur la Côte d'Azur — disponible partout.</p>
          <p class="about-sign">À très vite,<br />Roxane</p>
          <a href="#contact" class="btn btn--outline">Me contacter</a>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="section" id="contact">
      <div class="contact-wrap">
        <div class="section-head">
          <h2 class="title">Contact</h2>
        </div>
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="sr-only"><label>Ne pas remplir : <input name="bot-field" /></label></p>

          <div class="form-row">
            <div class="field">
              <label for="name">Prénom &amp; Nom</label>
              <input id="name" type="text" name="name" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" type="email" name="email" required autocomplete="email" />
            </div>
          </div>
          <div class="form-row">
            <div class="field">
              <label for="phone">Téléphone</label>
              <input id="phone" type="tel" name="phone" required autocomplete="tel" />
            </div>
            <div class="field">
              <label for="project">Projet</label>
              <select id="project" name="project" required>
                <option value="" disabled selected>Mariage ou couple ?</option>
                <option value="mariage">Mariage</option>
                <option value="couple">Couple</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="field">
              <label for="date">Date</label>
              <input id="date" type="text" name="date" required placeholder="JJ/MM/AAAA" />
            </div>
            <div class="field">
              <label for="lieu">Lieu</label>
              <input id="lieu" type="text" name="lieu" required placeholder="ex : Paris, Normandie…" />
            </div>
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea
              id="message" name="message" rows="5" required
              placeholder="Parlez-moi de votre histoire."
            ></textarea>
          </div>
          <button type="submit" class="btn">Envoyer</button>
        </form>
        <p class="contact-ig">
          Retrouvez-moi sur
          <a href="https://instagram.com/" target="_blank" rel="noopener noreferrer">Instagram</a>
        </p>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
      <span class="footer-logo">{brand}</span>
      <span class="footer-copy">&copy; {new Date().getFullYear()} Eterna. Tous droits réservés.</span>
    </footer>

    <script>
      // Nav scroll
      const nav  = document.getElementById('nav');
      const hero = document.querySelector('.hero');
      if (nav && hero) {
        new IntersectionObserver(
          ([e]) => nav.classList.toggle('nav--solid', !e.isIntersecting),
          { threshold: 0.05 }
        ).observe(hero);
      }

      // Menu mobile
      const mobileBtn  = document.getElementById('mobile-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      if (mobileBtn && mobileMenu) {
        function toggleMenu(open) {
          mobileBtn.classList.toggle('open', open);
          mobileMenu.classList.toggle('open', open);
          mobileBtn.setAttribute('aria-expanded', String(open));
          mobileMenu.setAttribute('aria-hidden', String(!open));
          document.body.style.overflow = open ? 'hidden' : '';
        }
        mobileBtn.addEventListener('click', () => toggleMenu(!mobileMenu.classList.contains('open')));
        mobileMenu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => toggleMenu(false)));
        document.addEventListener('keydown', e => { if (e.key === 'Escape') toggleMenu(false); });
      }
    </script>

  </body>
</html>
