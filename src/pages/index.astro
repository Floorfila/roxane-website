---
const brand = "Eterna";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Eterna — Photographie de mariage et de couple. L'instant préservé pour toujours."
    />
    <title>{brand} — Photographie de mariage et de couple</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,200;0,300;1,200;1,300&family=Inter:wght@200;300&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>

    <!-- NAV -->
    <header class="nav" id="nav">
      <a href="/" class="nav-logo">{brand}</a>
      <nav>
        <a href="#portfolio">Portfolio</a>
        <a href="#prestations">Prestations</a>
        <a href="#about">About Me</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <!-- HERO -->
    <section class="hero" aria-label="Introduction">
      <!-- Remplacer la div par <img src="/hero.jpg" … /> quand la photo est prête -->
      <div class="hero-img" aria-hidden="true"></div>
      <div class="hero-overlay" aria-hidden="true"></div>
      <div class="hero-content">
        <h1 class="hero-brand">{brand}</h1>
        <p class="hero-byline"><span class="by">by</span> <span class="roxane">Roxane</span></p>
        <p class="hero-specialty">Photographie de mariage et de couple</p>
      </div>
    </section>

    <!-- PORTFOLIO -->
    <section class="section" id="portfolio">
      <div class="section-head">
        <h2 class="title">Portfolio</h2>
      </div>
      <div class="gallery">
        {Array.from({ length: 9 }).map((_, i) => (
          <div class="gallery-item">
            <div class={`gallery-ph gallery-ph-${i + 1}`}></div>
          </div>
        ))}
      </div>
    </section>

    <!-- PRESTATIONS -->
    <section class="section" id="prestations">
      <div class="section-head">
        <h2 class="title">Prestations</h2>
      </div>
      <div class="presta-grid">

        <article class="presta-card">
          <h3 class="presta-title">Mariage</h3>
          <p class="presta-desc">
            Je photographie votre journée comme elle se vit — dans le désordre, la tendresse
            et la vérité des moments que vous ne voyez pas défiler.
          </p>
          <ul class="presta-includes">
            <li>Reportage complet de la journée</li>
            <li>Galerie privée en ligne</li>
            <li>Photos retouchées livrées sous 4 semaines</li>
            <li>Fichiers haute résolution</li>
          </ul>
          <p class="presta-price">Tarif sur devis</p>
          <a href="#contact" class="btn">Demander un devis</a>
        </article>

        <article class="presta-card">
          <h3 class="presta-title">Couple</h3>
          <p class="presta-desc">
            Une séance à deux, dans un endroit qui vous ressemble. Pas de pose imposée —
            juste vous, comme vous êtes.
          </p>
          <ul class="presta-includes">
            <li>Séance de 1h30 en extérieur ou en studio</li>
            <li>Galerie privée en ligne</li>
            <li>Photos retouchées livrées sous 2 semaines</li>
            <li>Fichiers haute résolution</li>
          </ul>
          <p class="presta-price">Tarif sur devis</p>
          <a href="#contact" class="btn">Demander un devis</a>
        </article>

      </div>
    </section>

    <!-- ABOUT -->
    <section class="section" id="about">
      <div class="about-grid">
        <div class="about-img-wrap">
          <!-- Remplacer par <img src="/about.jpg" alt="…" /> quand la photo est prête -->
          <div class="about-img-ph" aria-hidden="true"></div>
        </div>
        <div class="about-text">
          <h2 class="title">About Me</h2>
          <p>
            Je m'appelle [Prénom]. Je photographie les mariages et les couples
            depuis [X] ans.
          </p>
          <p>
            Mon approche est simple : je ne dirige pas. J'observe, je cherche,
            j'attends l'instant qui dit quelque chose de vrai sur vous deux.
          </p>
          <p>
            Je travaille en lumière naturelle, avec discrétion. Vous oublierez
            que je suis là. C'est exactement ce que je cherche.
          </p>
          <a href="#contact" class="btn btn--outline">Me contacter</a>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="section" id="contact">
      <div class="contact-wrap">
        <div class="section-head">
          <h2 class="title">Contact</h2>
        </div>
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="sr-only"><label>Ne pas remplir : <input name="bot-field" /></label></p>

          <div class="form-row">
            <div class="field">
              <label for="name">Prénom &amp; Nom</label>
              <input id="name" type="text" name="name" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" type="email" name="email" required autocomplete="email" />
            </div>
          </div>
          <div class="form-row">
            <div class="field">
              <label for="phone">Téléphone</label>
              <input id="phone" type="tel" name="phone" required autocomplete="tel" />
            </div>
            <div class="field">
              <label for="project">Projet</label>
              <select id="project" name="project" required>
                <option value="" disabled selected>Mariage ou couple ?</option>
                <option value="mariage">Mariage</option>
                <option value="couple">Couple</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="field">
              <label for="date">Souhait de date</label>
              <input id="date" type="text" name="date" required placeholder="ex : printemps 2026" />
            </div>
            <div class="field">
              <label for="lieu">Souhait de lieu</label>
              <input id="lieu" type="text" name="lieu" required placeholder="ex : Paris, Normandie…" />
            </div>
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea
              id="message" name="message" rows="5" required
              placeholder="Parlez-moi de votre histoire."
            ></textarea>
          </div>
          <button type="submit" class="btn">Envoyer</button>
        </form>
        <p class="contact-ig">
          Retrouvez-moi sur
          <a href="https://instagram.com/" target="_blank" rel="noopener noreferrer">Instagram</a>
        </p>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
      <span class="footer-logo">{brand}</span>
      <span class="footer-copy">&copy; {new Date().getFullYear()} Eterna. Tous droits réservés.</span>
    </footer>

    <script>
      const nav  = document.getElementById('nav');
      const hero = document.querySelector('.hero');
      if (nav && hero) {
        new IntersectionObserver(
          ([e]) => nav.classList.toggle('nav--solid', !e.isIntersecting),
          { threshold: 0.05 }
        ).observe(hero);
      }
    </script>

  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }

  :root {
    --bg:      #f4f0e8;
    --ink:     #1a1714;
    --muted:   #8a8078;
    --accent:  #a08870;
    --border:  rgba(26,23,20,0.1);

    --serif: 'Cormorant Garamond', Georgia, serif;
    --sans:  'Inter', system-ui, sans-serif;
    --ease:  cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 200;
    line-height: 1.7;
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap;
  }

  /* ── NAV ── */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.5rem 4rem;
    border-bottom: 1px solid transparent;
    transition: background 0.4s var(--ease), border-color 0.4s var(--ease);
  }
  /* Default : nav transparent sur le hero sombre → texte blanc */
  .nav-logo {
    font-family: var(--serif);
    font-size: 1.4rem; font-weight: 200;
    letter-spacing: 0.3em; text-transform: uppercase;
    text-decoration: none; color: #f4f0e8;
    transition: color 0.4s var(--ease);
  }
  .nav nav { display: flex; gap: 2.5rem; }
  .nav nav a {
    font-size: 0.67rem; font-weight: 300;
    letter-spacing: 0.16em; text-transform: uppercase;
    text-decoration: none; color: rgba(244,240,232,0.65);
    transition: color 0.2s;
  }
  .nav nav a:hover { color: #f4f0e8; }
  /* Scrollé : fond crème → texte sombre */
  .nav--solid {
    background: rgba(244,240,232,0.95);
    backdrop-filter: blur(10px);
    border-bottom-color: var(--border);
  }
  .nav--solid .nav-logo { color: var(--ink); }
  .nav--solid nav a { color: var(--muted); }
  .nav--solid nav a:hover { color: var(--ink); }

  /* ── HERO ── */
  .hero {
    position: relative;
    height: 100svh; min-height: 560px;
    display: flex; align-items: flex-end;
    overflow: hidden;
  }
  .hero-img {
    position: absolute; inset: 0;
    /* Placeholder — remplacer background par background-image: url('/hero.jpg') */
    background: linear-gradient(145deg, #2a2420 0%, #1a1410 50%, #0e0c0a 100%);
    background-size: cover;
    background-position: center;
  }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(10,8,6,0.75) 0%, rgba(10,8,6,0.1) 50%, transparent 100%);
  }
  .hero-content {
    position: relative; z-index: 1;
    padding: 0 4rem 5rem;
    color: #f4f0e8;
  }
  .hero-brand {
    font-family: var(--serif);
    font-size: clamp(3.5rem, 9vw, 9rem);
    font-weight: 200; line-height: 0.9;
    letter-spacing: 0.05em; text-transform: uppercase;
    color: #f4f0e8;
    margin-bottom: 0.5rem;
  }
  .hero-byline {
    font-family: var(--serif);
    font-weight: 200;
    font-size: clamp(0.85rem, 1.4vw, 1.1rem);
    color: rgba(244,240,232,0.55);
    margin-bottom: 1.2rem;
  }
  .hero-byline .by {
    font-style: italic;
    font-size: 0.9em;
  }
  .hero-byline .roxane {
    font-style: italic;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero-specialty {
    font-size: 0.62rem; font-weight: 300;
    letter-spacing: 0.28em; text-transform: uppercase;
    color: rgba(244,240,232,0.4);
  }

  /* ── SECTIONS ── */
  .section {
    background: var(--bg);
    padding: 7rem 4rem;
  }
  .section-head {
    margin-bottom: 3.5rem;
  }

  /* ── TITRES UPPERCASE ── */
  .title {
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 200; line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink);
    margin-bottom: 0.6rem;
  }
  .subtitle {
    font-size: 0.88rem; font-weight: 200;
    color: var(--muted);
  }

  /* ── BUTTONS ── */
  .btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    border: 1px solid var(--ink);
    background: var(--ink); color: var(--bg);
    font-family: var(--sans); font-size: 0.67rem;
    font-weight: 300; letter-spacing: 0.18em; text-transform: uppercase;
    text-decoration: none; cursor: pointer;
    transition: background 0.25s var(--ease), color 0.25s var(--ease);
  }
  .btn:hover { background: transparent; color: var(--ink); }
  .btn--outline {
    background: transparent; color: var(--ink);
  }
  .btn--outline:hover { background: var(--ink); color: var(--bg); }

  /* ── GALLERY ── */
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .gallery-item { aspect-ratio: 1 / 1; overflow: hidden; }
  .gallery-ph {
    width: 100%; height: 100%;
    transition: transform 0.6s var(--ease);
  }
  .gallery-item:hover .gallery-ph { transform: scale(1.04); }

  /* Placeholders neutres et chauds */
  .gallery-ph-1 { background: #d4cbbf; }
  .gallery-ph-2 { background: #c8c0b4; }
  .gallery-ph-3 { background: #d0c8bc; }
  .gallery-ph-4 { background: #c4bcb0; }
  .gallery-ph-5 { background: #ccc4b8; }
  .gallery-ph-6 { background: #beb8ac; }
  .gallery-ph-7 { background: #d2cac0; }
  .gallery-ph-8 { background: #c6beb4; }
  .gallery-ph-9 { background: #cabfb4; }

  /* ── PRESTATIONS ── */
  .presta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }
  .presta-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-bottom: none;
    padding: 3rem;
    display: flex; flex-direction: column; gap: 1.5rem;
  }
  .presta-title {
    font-family: var(--serif);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 200; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--ink);
  }
  .presta-desc {
    font-size: 0.88rem; font-weight: 200;
    color: var(--muted); line-height: 1.8;
  }
  .presta-includes {
    list-style: none;
    display: flex; flex-direction: column; gap: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }
  .presta-includes li {
    font-size: 0.82rem; font-weight: 200;
    color: var(--ink); padding-left: 1rem; position: relative;
  }
  .presta-includes li::before {
    content: '—';
    position: absolute; left: 0;
    color: var(--accent); font-size: 0.7rem;
  }
  .presta-price {
    font-size: 0.8rem; font-weight: 300;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--muted); margin-top: auto;
  }

  /* ── ABOUT ── */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }
  .about-img-wrap { }
  .about-img-ph {
    aspect-ratio: 3 / 4;
    /* Placeholder — remplacer par <img src="/about.jpg" … /> */
    background: linear-gradient(155deg, #cec6bc 0%, #b8b0a6 100%);
  }
  .about-text {
    display: flex; flex-direction: column; gap: 1rem;
  }
  .about-text .title { margin-bottom: 0.5rem; }
  .about-text p {
    font-size: 0.88rem; font-weight: 200;
    color: var(--muted); line-height: 1.85;
  }
  .about-text .btn { align-self: flex-start; margin-top: 0.5rem; }

  /* ── CONTACT ── */
  .contact-wrap { max-width: 640px; }
  form {
    display: flex; flex-direction: column; gap: 1.6rem;
    margin-top: 2.5rem;
  }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; }
  .field { display: flex; flex-direction: column; gap: 0.4rem; }
  .field label {
    font-size: 0.6rem; font-weight: 300;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--muted);
  }
  form input, form select, form textarea {
    background: transparent;
    border: none; border-bottom: 1px solid var(--border);
    padding: 0.55rem 0; width: 100%;
    color: var(--ink);
    font-family: var(--sans); font-size: 0.9rem; font-weight: 200;
    outline: none; transition: border-color 0.2s;
  }
  form input:focus, form select:focus, form textarea:focus {
    border-bottom-color: var(--ink);
  }
  form select { -webkit-appearance: none; cursor: pointer; }
  form textarea { resize: vertical; }
  form ::placeholder { color: rgba(26,23,20,0.3); }
  form button { align-self: flex-start; }

  /* ── CONTACT INSTAGRAM ── */
  .contact-ig {
    margin-top: 2rem;
    font-size: 0.75rem; font-weight: 200;
    color: var(--muted);
  }
  .contact-ig a {
    color: var(--ink); text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1px;
    transition: border-color 0.2s;
  }
  .contact-ig a:hover { border-bottom-color: var(--ink); }

  /* ── FOOTER ── */
  .footer {
    background: var(--bg);
    border-top: 1px solid var(--border);
    padding: 1.5rem 4rem;
    display: flex; justify-content: space-between; align-items: center;
  }
  .footer-logo {
    font-family: var(--serif);
    font-size: 1rem; font-weight: 200;
    letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--ink);
  }
  .footer-copy {
    font-size: 0.65rem; font-weight: 200;
    letter-spacing: 0.06em; color: var(--muted);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 860px) {
    .nav { padding: 1.2rem 2rem; }
    .section { padding: 5rem 2rem; }
    .hero-content { padding: 0 2rem 4rem; }
    .gallery { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .presta-grid { grid-template-columns: 1fr; }
    .about-grid { grid-template-columns: 1fr; gap: 3rem; }
    .footer { padding: 1.5rem 2rem; }
  }

  @media (max-width: 540px) {
    .nav nav { display: none; }
    .gallery { grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .form-row { grid-template-columns: 1fr; }
    .hero-brand { letter-spacing: 0.02em; }
  }
</style>
