---
import '../../styles/site.css';
const brand = "Eterna";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Eterna — Wedding & couple photography by Roxane. Every moment, preserved forever."
    />
    <link rel="alternate" hreflang="fr" href="/" />
    <title>{brand} — Wedding &amp; Couple Photography</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,200;0,300;1,200;1,300&family=Inter:wght@200;300&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>

    <!-- NAV -->
    <header class="nav" id="nav">
      <a href="/en/" class="nav-logo">{brand}</a>
      <div class="nav-right">
        <nav>
          <a href="#portfolio">Portfolio</a>
          <a href="#services">Services</a>
          <a href="#about">About Me</a>
          <a href="#contact">Contact</a>
        </nav>
        <div class="lang-switch" aria-label="Language">
          <a href="/" class="lang-link">FR</a>
          <span class="lang-dot" aria-hidden="true">·</span>
          <span class="lang-link lang-active" aria-current="true">EN</span>
        </div>
      </div>
      <button class="nav-mobile-btn" id="mobile-btn" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </header>

    <!-- MOBILE MENU -->
    <div class="nav-mobile" id="mobile-menu" aria-hidden="true">
      <nav class="mobile-links">
        <a href="#portfolio">Portfolio</a>
        <a href="#services">Services</a>
        <a href="#about">About Me</a>
        <a href="#contact">Contact</a>
      </nav>
      <div class="mobile-lang">
        <a href="/" class="lang-link">FR</a>
        <span class="lang-dot" aria-hidden="true">·</span>
        <span class="lang-link lang-active">EN</span>
      </div>
    </div>

    <!-- HERO -->
    <section class="hero" aria-label="Introduction">
      <div class="hero-img" aria-hidden="true"></div>
      <div class="hero-overlay" aria-hidden="true"></div>
      <div class="hero-content">
        <h1 class="hero-brand">{brand}</h1>
        <p class="hero-byline"><span class="by">by</span> <span class="roxane">Roxane</span></p>
        <p class="hero-specialty">Wedding &amp; Couple Photography</p>
      </div>
    </section>

    <!-- PORTFOLIO -->
    <section class="section" id="portfolio">
      <div class="section-head">
        <h2 class="title">Portfolio</h2>
      </div>
      <div class="gallery">
        {Array.from({ length: 9 }).map((_, i) => (
          <div class="gallery-item">
            <div class={`gallery-ph gallery-ph-${i + 1}`}></div>
          </div>
        ))}
      </div>
    </section>

    <!-- SERVICES -->
    <section class="section" id="services">
      <div class="section-head">
        <h2 class="title">Services</h2>
      </div>
      <div class="presta-grid">

        <article class="presta-card">
          <h3 class="presta-title">Wedding</h3>
          <p class="presta-desc">
            I capture your day as you live it —<br />
            the chaos, the tenderness, the truth of every moment.
          </p>
          <p class="presta-section-label">Experience</p>
          <ul class="presta-includes">
            <li>Reach out through the contact form</li>
            <li>A conversation on WhatsApp</li>
            <li>A video call to hear your story</li>
            <li>Then open exchanges, as much as you need, until the day</li>
          </ul>
          <p class="presta-section-label">What you receive</p>
          <ul class="presta-includes">
            <li>Full-day coverage</li>
            <li>High-resolution files</li>
            <li>Delivery within 6 weeks</li>
            <li>One print, chosen by my eye</li>
          </ul>
          <p class="presta-price">
            From 2,200 €
            <span class="presta-price-note">Travel and accommodation costs may apply.</span>
          </p>
          <a href="#contact" class="btn">Get in touch</a>
        </article>

        <article class="presta-card">
          <h3 class="presta-title">Couple Session</h3>
          <p class="presta-desc">
            I capture your moment together —<br />
            your closeness, your love, in a place that feels like you.
          </p>
          <p class="presta-section-label">Experience</p>
          <ul class="presta-includes">
            <li>Reach out through the contact form</li>
            <li>A conversation on WhatsApp</li>
            <li>A quick video call to set the intention</li>
            <li>Then free preparation, on your own terms</li>
          </ul>
          <p class="presta-section-label">The session</p>
          <ul class="presta-includes">
            <li>1.5 to 2 hours</li>
            <li>In a real place: a café, your flat, a train…</li>
          </ul>
          <p class="presta-section-label">What you receive</p>
          <ul class="presta-includes">
            <li>High-resolution files</li>
            <li>Delivery within 6 weeks</li>
          </ul>
          <p class="presta-price">
            From 500 €
            <span class="presta-price-note">Travel and accommodation costs may apply.</span>
          </p>
          <a href="#contact" class="btn">Get in touch</a>
        </article>

      </div>
    </section>

    <!-- ABOUT -->
    <section class="section" id="about">
      <div class="about-grid">
        <div class="about-img-wrap">
          <div class="about-img-ph" aria-hidden="true"></div>
        </div>
        <div class="about-text">
          <h2 class="title">About Me</h2>
          <p>
            Through my lens, I look for what connects you — the intensity of an emotion,
            the depth of a gaze, the beauty of your love.
          </p>
          <p>
            I don't capture perfection.<br />
            I capture what is true, what runs deep, what you can feel.
          </p>
          <p>
            My eye is shaped by everything around me —
            a setting sun, a fading light, a landscape, an atmosphere.
          </p>
          <p>
            I draw from film photography:
            texture, grain, soft tones, real colours.
          </p>
          <p>
            I work with care and trust,
            discreet when needed, present when it matters.
          </p>
          <p class="about-location">Based on the French Riviera — available everywhere.</p>
          <p class="about-sign">See you soon,<br />Roxane</p>
          <a href="#contact" class="btn btn--outline">Get in touch</a>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="section" id="contact">
      <div class="contact-wrap">
        <div class="section-head">
          <h2 class="title">Contact</h2>
        </div>
        <form
          name="contact-en"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="contact-en" />
          <p class="sr-only"><label>Do not fill in: <input name="bot-field" /></label></p>

          <div class="form-row">
            <div class="field">
              <label for="name">First &amp; Last Name</label>
              <input id="name" type="text" name="name" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" type="email" name="email" required autocomplete="email" />
            </div>
          </div>
          <div class="form-row">
            <div class="field">
              <label for="phone">Phone</label>
              <input id="phone" type="tel" name="phone" required autocomplete="tel" />
            </div>
            <div class="field">
              <label for="project">Project</label>
              <select id="project" name="project" required>
                <option value="" disabled selected>Wedding or couple session?</option>
                <option value="wedding">Wedding</option>
                <option value="couple">Couple session</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="field">
              <label for="date">Date</label>
              <input id="date" type="text" name="date" required placeholder="DD/MM/YYYY" />
            </div>
            <div class="field">
              <label for="lieu">Location</label>
              <input id="lieu" type="text" name="lieu" required placeholder="e.g. Paris, Normandy…" />
            </div>
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea
              id="message" name="message" rows="5" required
              placeholder="Tell me about your story."
            ></textarea>
          </div>
          <button type="submit" class="btn">Send</button>
        </form>
        <p class="contact-ig">
          Find me on
          <a href="https://instagram.com/" target="_blank" rel="noopener noreferrer">Instagram</a>
        </p>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
      <span class="footer-logo">{brand}</span>
      <span class="footer-copy">&copy; {new Date().getFullYear()} Eterna. All rights reserved.</span>
    </footer>

    <script>
      // Nav scroll
      const nav  = document.getElementById('nav');
      const hero = document.querySelector('.hero');
      if (nav && hero) {
        new IntersectionObserver(
          ([e]) => nav.classList.toggle('nav--solid', !e.isIntersecting),
          { threshold: 0.05 }
        ).observe(hero);
      }

      // Mobile menu
      const mobileBtn  = document.getElementById('mobile-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      if (mobileBtn && mobileMenu) {
        function toggleMenu(open) {
          mobileBtn.classList.toggle('open', open);
          mobileMenu.classList.toggle('open', open);
          mobileBtn.setAttribute('aria-expanded', String(open));
          mobileMenu.setAttribute('aria-hidden', String(!open));
          document.body.style.overflow = open ? 'hidden' : '';
        }
        mobileBtn.addEventListener('click', () => toggleMenu(!mobileMenu.classList.contains('open')));
        mobileMenu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => toggleMenu(false)));
        document.addEventListener('keydown', e => { if (e.key === 'Escape') toggleMenu(false); });
      }
    </script>

  </body>
</html>
